# Nginx sur 110 — reverse proxy ComfyUI vers 140
# Copier : sudo cp infra/nginx/comfyui_110.conf.example /etc/nginx/sites-available/comfyui-infographiste
# Activer : sudo ln -s ... sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx

upstream comfyui_140 {
    server 192.168.0.140:8188;
    keepalive 8;
}

server {
    listen 8189;
    server_name _;

    # LAN uniquement (ajuster selon ton réseau)
    allow 192.168.0.0/24;
    deny all;

    client_max_body_size 100M;

    location / {
        proxy_pass http://comfyui_140;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Rendus longs (batch, LoRA inference)
        proxy_connect_timeout 60s;
        proxy_send_timeout 14400s;
        proxy_read_timeout 14400s;
    }

    # Option basic auth (décommenter) :
    # auth_basic "ComfyUI Infographiste";
    # auth_basic_user_file /etc/nginx/.htpasswd-comfyui;
}
