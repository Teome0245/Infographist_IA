# Profil LOCAL — GPU sur PC Windows uniquement (VMs 110/140 sans GPU)
# Copier : cp config/.env.local.example .env

INFRA_MODE=LOCAL
GPU_TARGET=pc_windows

# ComfyUI Windows — IP passerelle WSL (après reboot : ip route show default | awk '{print $3}')
COMFY_LOCAL_URL=http://172.24.160.1:8188

COMFY_REQUEST_TIMEOUT_S=30
COMFY_POLL_INTERVAL_S=2
COMFY_JOB_TIMEOUT_S=1800

# Stockage données lourdes sur B: (pas C:, pas les VMs)
DATA_ROOT=/mnt/b/Infographiste_IA
DATA_ROOT_WIN=B:\\Infographiste_IA

DATASET_DIR=dataset/inspiration_mmorpg
ASSETS_DIR=/mnt/b/Infographiste_IA/assets/images
LOCAL_LORA_DIR=/mnt/b/Infographiste_IA/lora
KOHYA_TRAIN_DIR=/mnt/b/Infographiste_IA/kohya_train

# VMs LAN — stockage / LLM chat seulement (pas de ComfyUI / vision distant)
LBG_HOST_FRONT=192.168.0.110
LBG_HOST_CORE=192.168.0.140
NAS_SYNC_ENABLED=0

# Vision / graphique → Ollama local GPU (.10), pas la VM 110
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava-phi3
OLLAMA_TIMEOUT_S=120
OLLAMA_KEEP_ALIVE=30s
INFOGRAPHISTE_VISION_QUEUE=1
INFOGRAPHISTE_VISION_QUEUE_TIMEOUT_S=7200
