# Mode d'exécution: LOCAL ou DISTRIBUTED
INFRA_MODE=LOCAL

# Pour DISTRIBUTED: choisir l'infra (110 ou 140)
INFRA_TARGET=110

# Override (optionnel) des URLs
COMFY_LOCAL_URL=http://127.0.0.1:8188
COMFY_REMOTE_URL_110=https://infra-110.example.com/comfy
COMFY_REMOTE_URL_140=https://infra-140.example.com/comfy

# Timeouts (optionnel)
COMFY_REQUEST_TIMEOUT_S=30
COMFY_POLL_INTERVAL_S=2
COMFY_JOB_TIMEOUT_S=1800

# Stockage S3 (DISTRIBUTED)
S3_BUCKET=my-mmorpgh-assets-bucket
S3_PREFIX=infographiste-virtuel
AWS_REGION=eu-west-3

# Dossiers projet
DATASET_DIR=dataset
ASSETS_DIR=assets/images
LOCAL_LORA_DIR=lora

