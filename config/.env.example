# Mode d'exécution: LOCAL ou DISTRIBUTED
INFRA_MODE=LOCAL

# Pour DISTRIBUTED: choisir l'infra (110 ou 140)
INFRA_TARGET=110

# Override (optionnel) des URLs
# WSL → ComfyUI Windows : utiliser l'IP passerelle (ip route show default | awk '{print $3}')
COMFY_LOCAL_URL=http://172.24.160.1:8188
# ComfyUI natif sur la même machine :
# COMFY_LOCAL_URL=http://127.0.0.1:8188
COMFY_REMOTE_URL_110=https://infra-110.example.com/comfy
COMFY_REMOTE_URL_140=https://infra-140.example.com/comfy

# Timeouts (optionnel)
COMFY_REQUEST_TIMEOUT_S=30
COMFY_POLL_INTERVAL_S=2
COMFY_JOB_TIMEOUT_S=1800

# Stockage S3 (DISTRIBUTED)
S3_BUCKET=my-mmorpgh-assets-bucket
S3_PREFIX=infographiste-virtuel
AWS_REGION=eu-west-3

# Stockage sur B: (évite de saturer C:)
# WSL :
DATA_ROOT=/mnt/b/Infographiste_IA
# Windows (kohya / cmd.exe) :
DATA_ROOT_WIN=B:\\Infographiste_IA

DATASET_DIR=dataset/inspiration_mmorpg
ASSETS_DIR=/mnt/b/Infographiste_IA/assets/images
LOCAL_LORA_DIR=/mnt/b/Infographiste_IA/lora
KOHYA_TRAIN_DIR=/mnt/b/Infographiste_IA/kohya_train

