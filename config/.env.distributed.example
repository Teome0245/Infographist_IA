# Profil DISTRIBUTED — LAN LBG (Proxmox)
# ⚠️  À activer UNIQUEMENT quand 140 (ou 110) aura un GPU pour ComfyUI.
# Sans GPU sur les VMs : garder INFRA_MODE=LOCAL (PC dev Windows).
#
# Copier vers .env quand prêt :
#   cp config/.env.distributed.example .env

INFRA_MODE=DISTRIBUTED

# ComfyUI GPU : worker 140 (direct) ou proxy 110
# Recommandé : 140 (moins de latence, GPU local à ComfyUI)
INFRA_TARGET=140

# --- Endpoints ComfyUI ---
# Direct GPU worker (140)
COMFY_REMOTE_URL_140=http://192.168.0.140:8188
# Via reverse proxy Nginx sur 110 (optionnel, auth/TLS)
COMFY_REMOTE_URL_110=http://192.168.0.110:8189

# Timeouts (rendus batch / LoRA / multi-view)
COMFY_REQUEST_TIMEOUT_S=60
COMFY_POLL_INTERVAL_S=3
COMFY_JOB_TIMEOUT_S=14400

# Auth optionnelle (si Nginx basic auth ou Bearer sur 110)
# COMFY_AUTH_HEADER=Authorization
# COMFY_AUTH_VALUE=Bearer <token>

# --- Stockage NAS (pas S3 pour l'instant) ---
STORAGE_BACKEND=NAS
NAS_MOUNT_PATH=/mnt/nas_lbg/Infographiste_IA
NAS_UNC=//Nas_lbg/nas/LBG_Cloud_Drive/Infographiste_IA

# Chemins projet (sur poste dev WSL — inchangés en LOCAL)
# En mode DISTRIBUTED, dataset/outputs peuvent être sur NAS via sync
DATASET_DIR=dataset/inspiration_mmorpg
ASSETS_DIR=/mnt/b/Infographiste_IA/assets/images
LOCAL_LORA_DIR=/mnt/b/Infographiste_IA/lora
KOHYA_TRAIN_DIR=/mnt/b/Infographiste_IA/kohya_train

# Hôtes LAN (scripts deploy / healthcheck)
LBG_HOST_FRONT=192.168.0.110
LBG_HOST_CORE=192.168.0.140
LBG_VM_USER=lbg
